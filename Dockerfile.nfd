# NFD 24.07 is paired with NLSR 24.08 (see Dockerfile.nlsr).
FROM ghcr.io/named-data/nfd:24.07

USER root

ENV HOME=/tmp/nfd-home

# The upstream image keeps its sample configuration under /config, which is a
# ConfigMap mount in the Pod. Store the generated configuration outside it.
RUN apt-get update && apt-get install -y --no-install-recommends coreutils mawk sed \
    && mkdir -p /etc/ndn \
    && cp /config/nfd.conf /etc/ndn/nfd.conf \
    && sed -i 's|path /run/nfd/nfd.sock|path /run/nfd.sock|g' /etc/ndn/nfd.conf \
    && sed -i '/^[[:space:]]*auto_prefix_propagate[[:space:]]*$/,/^[[:space:]]*}[[:space:]]*$/d' /etc/ndn/nfd.conf \
    && sed -i '/^[[:space:]]*localhost_security[[:space:]]*$/i \  localhop_security\n  {\n    trust-anchor\n    {\n      type any\n    }\n  }' /etc/ndn/nfd.conf \
    && sed -i '/^[[:space:]]*readvertise_nlsr[[:space:]]/d' /etc/ndn/nfd.conf \
    && sed -i '/^[[:space:]]*localhost_security[[:space:]]*$/i \  readvertise_nlsr yes' /etc/ndn/nfd.conf \
    && rm -rf /var/lib/apt/lists/*

CMD ["--config", "/etc/ndn/nfd.conf"]
